# ============================================================
# Infraestrutura e chaves globais. Configuração de cada empresa
# (tenant) fica no banco a partir da Fase 0.5, não aqui.
# ============================================================

# --- Postgres ---
POSTGRES_DB=bykoji
POSTGRES_USER=bykoji
POSTGRES_PASSWORD=troque-esta-senha

# --- Redis ---
REDIS_PASSWORD=troque-redis-senha

# --- Segurança (Fase 0) ---
# O gateway NÃO sobe se estas chaves estiverem vazias, com menos de 16 caracteres
# ou ainda começando com "troque". Gere com: openssl rand -hex 24
# chave para rotas /admin e /test (substituídas por /admin/v1 na Fase 0.5)
ADMIN_KEY=troque-admin-key
# chave que as Skills do Skyone usam para chamar /api/* (vira chave por tenant na Fase 0.5)
SKILLS_API_KEY=troque-skills-key
# segredo na URL do webhook do uazapi: /webhooks/uazapi?s=<valor> (vira segredo por canal na Fase 0.5)
UAZAPI_WEBHOOK_SECRET=troque-webhook-secret

# --- Debounce (padrões; por tenant a partir da Fase 0.5) ---
DEBOUNCE_S=4
MAX_WAIT_S=12
HISTORY_TURNS=20
PAUSE_MINUTES=60

# --- Agente Skyone (Fase 0–2; por tenant a partir da Fase 0.5) ---
# mock = resposta simulada (mede só a VPS); live = chama o fluxo do Skyone
SKYONE_MODE=mock
SKYONE_WEBHOOK_URL=
SKYONE_TOKEN=troque-token-skyone
SKYONE_TIMEOUT_S=90
SLOW_NOTICE_S=15
MOCK_MIN_S=2
MOCK_MAX_S=5

# --- Diagnóstico Skyone (Fase 0.3; somente fluxo de teste) ---
# Usado por scripts/skyone_probe.py. Não altera SKYONE_MODE nem SEND_MODE.
# Sem fallback para credenciais de produção; token vazio só no probe.
SKYONE_PROBE_URL=
SKYONE_PROBE_TOKEN=

# --- uazapi (Fase 0–1; por canal a partir da Fase 0.5) ---
# dry = não envia nada ao WhatsApp (só grava); live = envia de verdade
SEND_MODE=dry
UAZAPI_BASE_URL=https://SEU-SUBDOMINIO.uazapi.com
UAZAPI_TOKEN=

# --- SaaS (Fase 0.5) ---
# chave que o servidor do painel web usa para chamar /admin/v1
PANEL_SERVICE_KEY=troque-panel-key
PANEL_SERVICE_KEY_NEXT=
GATEWAY_PUBLIC_URL=https://painel.luxbrain.com.br/gateway
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# pepper para o hash das chaves de API dos tenants (SEG04)
API_KEY_PEPPER=troque-pepper

# --- Transcrição (Fase 5) ---
OPENAI_API_KEY=

# --- Proteções e LGPD ---
# documentação /docs: deixe false em produção
DOCS_ENABLED=false
# dias de retenção do payload bruto de webhooks
WEBHOOK_RAW_DIAS=30
# tamanho máximo do corpo das requisições (bytes)
MAX_BODY_BYTES=2097152

# Após provisionar o banco próprio, selecionar docker-compose.database.yml no COMPOSE_FILE.
# Credencial exclusiva do gateway; não substituir POSTGRES_* do cluster legado.
# GATEWAY_DATABASE_URL=postgresql://gateway:SENHA_FORTE@postgres:5432/gateway

# Teto compartilhado por URL Skyone, em janela móvel de 60 s (300 no provedor).
SKYONE_REQUESTS_PER_MINUTE=240
